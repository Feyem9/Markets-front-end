{
  "outputDirectory": "dist/market",
  "build": {
    "env": {
      "NPM_FLAGS": "--legacy-peer-deps"
    },
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
    "use": "@vercel/angular",
    "config": {
      "distDir": "dist/market"
    }
  }
}